<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp">

    <LinearLayout
        android:id="@+id/seam_idle"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/seam_cut"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/pressed_circle"
            android:contentDescription="@string/seam_cut"
            android:padding="4dp"
            android:src="@drawable/ic_cut" />

        <ImageView
            android:id="@+id/seam_undo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/pressed_circle"
            android:contentDescription="@string/seam_undo"
            android:padding="4dp"
            android:src="@drawable/ic_undo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seam_cutting"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/seam_confirm"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/pressed_circle"
            android:contentDescription="@string/seam_confirm"
            android:padding="4dp"
            android:src="@drawable/ic_done" />

        <ImageView
            android:id="@+id/seam_cancel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/pressed_circle"
            android:contentDescription="@string/seam_cancel"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>
</FrameLayout>
