<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/controls_close"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_solid"
        android:contentDescription="@string/controls_close"
        android:padding="15dp"
        android:src="@drawable/ic_close" />

    <ImageView
        android:id="@+id/controls_add"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/round_translucent"
        android:contentDescription="@string/controls_add"
        android:padding="20dp"
        android:src="@drawable/ic_add" />

    <ImageView
        android:id="@+id/controls_done"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/round_solid"
        android:contentDescription="@string/controls_done"
        android:padding="12dp"
        android:src="@drawable/ic_done" />
</LinearLayout>
